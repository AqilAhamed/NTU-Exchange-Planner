# Copy to backend/.env and fill in. Never commit backend/.env.

# --- LLM provider --------------------------------------------------------
# groq   -> local development (free tier is rate limited, not billed)
# bedrock-> reserved deployment boundary, not implemented yet
# null   -> deterministic only; the app still runs, the LLM lanes degrade
LLM_PROVIDER=groq

# Get a key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# The hackathon workshop default. Note: llama-3.3-70b-versatile is documented
# as failing with tool_use_failed in agentic harnesses -- avoid it here.
GROQ_MODEL=openai/gpt-oss-120b

# --- Bedrock (deployment only; do not enable without approval) ------------
# Read model ids from this constant, never build them by hand.
# BEDROCK_MODEL_ID=global.anthropic.claude-haiku-4-5-20251001-v1:0
# AWS_REGION=us-east-1

# --- Data ----------------------------------------------------------------
# Relative paths resolve against the repository root.
COURSEFINDER_DB=coursefinder.db
APP_STATE_DB=data/app_state.db
GENERAL_QUESTIONS_DATASET_DIR=../Dataset for General Questions Agent
GENERAL_QUESTIONS_CHROMA_DIR=data/general_questions_chroma
GENERAL_QUESTIONS_EMBEDDING_DIR=data/general_questions_embedding

# --- API -----------------------------------------------------------------
# Comma-separated. Defaults to http://localhost:3000,http://127.0.0.1:3000.
# Do not use "*" on a deployed instance: these endpoints have no authentication.
# CORS_ALLOW_ORIGINS=http://localhost:3000

# --- Web search (research lane) ------------------------------------------
# openserp -> self-hosted, see docker-compose.yml
# null     -> research lane returns a structured "unavailable" result
# tavily   -> hosted, what the deployed container runs. 1,000 free credits a
#             month, no card. Key from https://app.tavily.com  (starts tvly-)
# openserp -> self-hosted, see docker-compose.yml. Good locally; cannot run on
#             Lambda, which has no /dev/shm for Chromium.
SEARCH_PROVIDER=tavily
TAVILY_API_KEY=your_tavily_api_key_here
# basic (1 credit) or advanced (2 credits, deeper crawl).
TAVILY_SEARCH_DEPTH=basic
# Full page text instead of Tavily's ranked passage. Costs extra credits.
# TAVILY_INCLUDE_RAW=false
OPENSERP_URL=http://127.0.0.1:7000
# duckduckgo and bing are far less captcha-prone than google for a live demo
OPENSERP_ENGINE=duckduckgo
